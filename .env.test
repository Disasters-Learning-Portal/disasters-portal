# Values used by `pnpm test` (see vitest.config.mts). Other env files are ignored in tests.
# The URLs are placeholders on purpose: no test calls them, they only need to be set because
# env.helpers.ts throws on import without them. The reserved .test domain never resolves.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_DATA_VISUALIZATION_URL=https://example.test/data-visualization
NEXT_PUBLIC_STAC_API_URL=https://example.test/api/stac
NEXT_PUBLIC_RASTER_API_URL=https://example.test/api/raster
