{
  "name": "disasters-portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:staged": "biome check",
    "lint:ci": "biome ci .",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome format --write .",
    "prepare": "lefthook install",
    "dead-code": "fallow dead-code"
  },
  "dependencies": {
    "@teamimpact/veda-ui-blocks": "0.1.0-beta.26",
    "next": "16.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^20.19.37",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fallow": "^3.39.0",
    "image-size": "^2.1.0",
    "lefthook": "^2.1.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
