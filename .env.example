# Serve the app under a path (e.g. /disasters) if defined, defaults to root.
NEXT_PUBLIC_BASE_PATH=

# Required. URL of the MMGIS data visualization tool (Explore Data buttons).
# Absolute URL, or a root-relative path such as /data-visualization to stay on
# the host that served the portal (the base path is added automatically).
NEXT_PUBLIC_DATA_VISUALIZATION_URL=https://dev.disasters.openveda.cloud/disasters/data-visualization

# Required. STAC API root for the map blocks.
NEXT_PUBLIC_STAC_API_URL=https://dev.disasters.openveda.cloud/api/stac

# Required. Raster API (TiTiler) root for the map blocks.
NEXT_PUBLIC_RASTER_API_URL=https://dev.disasters.openveda.cloud/api/raster
